# Credenciales para E2E tests
# Copiar a .env.e2e (lo carga playwright.config.ts; .env.e2e está en .gitignore)
# y llenar. Contra una base sembrada en local, cada E2E_<ROL>_PASSWORD es la
# misma que su SEED_<ROL>_PASSWORD del .env. Ver __tests__/e2e/helpers/seed.ts.
#
# Si E2E_BASE_URL no es localhost, Playwright NO levanta un servidor local.
E2E_BASE_URL=http://localhost:3000

# Emails: opcionales. Por defecto, los de las cuentas del seed.
E2E_ADMIN_EMAIL=
E2E_COMPANY_EMAIL=
E2E_RECRUITER_EMAIL=
E2E_SPECIALIST_EMAIL=
E2E_CANDIDATE_EMAIL=

# Contraseñas: obligatorias para los tests que inician sesión.
E2E_ADMIN_PASSWORD=
E2E_COMPANY_PASSWORD=
E2E_RECRUITER_PASSWORD=
E2E_SPECIALIST_PASSWORD=
E2E_CANDIDATE_PASSWORD=
